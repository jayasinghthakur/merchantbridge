{
  "name": "merchantbridge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @mb/api dev",
    "dev:api:fake-live": "pnpm --filter @mb/api dev:fake-live",
    "dev:web": "pnpm --filter @mb/web dev",
    "gen:tools": "pnpm --filter @mb/api gen:tools",
    "evals": "pnpm --filter @mb/evals evals",
    "smoke": "tsx scripts/smoke.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
