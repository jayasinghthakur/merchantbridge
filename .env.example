# MerchantBridge environment variables — names only. Copy to .env and fill in locally; never commit .env.
# Nothing is required for local development: with no values the API runs in memory with the FakeZoho demo.
# Production values live in the Vercel project merchantbridge-api (set with `vercel env add`, then redeploy); the web
# project's NEXT_PUBLIC_* values are inlined by scripts/deploy-vercel.sh. See docs/deploy.md (the $0 path: Vercel Hobby
# + Neon + Upstash + Groq).

# --- apps/api: runtime ---
NODE_ENV=
PORT=
HOST=
LOG_LEVEL=
MB_PUBLIC_API_URL=
MB_PUBLIC_WEB_URL=
MB_ALLOWED_HOSTS=
MB_CORS_ORIGINS=
# socket | fly-client-ip | xff-last  (xff-last on Vercel; auto fly-client-ip on Fly)
MB_CLIENT_IP_SOURCE=
MB_TRUSTED_EGRESS_CIDRS=
MB_METRICS_TOKEN=

# --- apps/api: storage (required in production) ---
DATABASE_URL=
# Neon direct (unpooled) URL for migrations; falls back to DATABASE_URL
DATABASE_URL_UNPOOLED=
REDIS_URL=

# --- apps/api: Zoho connect (all required to enable /connect) ---
# openssl rand -base64 32
MB_ENCRYPTION_KEY=
# openssl rand -base64 48
MB_STATE_SECRET=
MB_CONNECT_INVITE_CODE=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=

# --- apps/api: playground + evals (live LLM agent; enabled = MB_PLAYGROUND_ENABLED=true + the provider's key) ---
# openai | anthropic. Default: openai when MB_LLM_API_KEY is set, else anthropic when ANTHROPIC_API_KEY is set.
MB_LLM_PROVIDER=
# Any OpenAI-compatible endpoint. Default https://api.groq.com/openai/v1 (Groq free tier, no card)
MB_LLM_BASE_URL=
# Key for MB_LLM_BASE_URL (Groq: console.groq.com)
MB_LLM_API_KEY=
# Optional, paid: only with MB_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MB_PLAYGROUND_ENABLED=
# Default openai/gpt-oss-120b (openai, Groq free tier) or claude-haiku-4-5 (anthropic)
MB_PLAYGROUND_MODEL=
MB_PLAYGROUND_DAILY_CAP=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- local only: fake-live mode (never in production) ---
MB_DEV_FAKE_ZOHO=

# --- scripts/smoke.ts (human-run against a real org, DEV client) ---
ZOHO_DEV_CLIENT_ID=
ZOHO_DEV_CLIENT_SECRET=
ZOHO_DEV_REFRESH_TOKEN=
ZOHO_DEV_DC=
ZOHO_DEV_ORG_ID=

# --- apps/web (Vercel) ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_REPO_URL=
